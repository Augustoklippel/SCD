<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".layout.ReaderActivity">

    <TextView
        android:id="@+id/lb_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:textColor="@color/custom_secondary"
        android:textSize="18sp"
        android:text="@string/code"
        android:layout_margin="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edt_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:textSize="18sp"
        android:labelFor="@id/lb_code"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@+id/lb_code"
        tools:ignore="MissingConstraints"
        android:autofillHints=""
        tools:layout_editor_absoluteX="16dp" />

    <ImageButton
        android:id="@+id/btn_seek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/baseline_search_24"
        tools:layout_editor_absoluteX="226dp"
        tools:layout_editor_absoluteY="24dp"
        android:contentDescription="@string/btn_reader"
        android:backgroundTint="@color/custom_secondary"
        tools:ignore="MissingConstraints"
        android:minHeight="60dp"
        android:minWidth="60dp"
        app:layout_constraintStart_toEndOf="@id/edt_code"/>

    <TextView
        android:id="@+id/lb_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="44dp"
        android:ems="10"
        android:text="@string/description"
        android:textColor="@color/custom_secondary"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_code" />

    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ems="10"
        android:text=""
        android:textColor="@color/custom_secondary"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lb_description" />

    <TextView
        android:id="@+id/lb_number"
        android:layout_width="83dp"
        android:layout_height="23dp"
        android:layout_margin="12dp"
        android:layout_marginTop="12dp"
        android:ems="10"
        android:text="@string/number"
        android:textColor="@color/custom_secondary"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/tv_description"
        tools:layout_editor_absoluteX="12dp" />

    <TextView
        android:id="@+id/tv_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:ems="10"
        android:text=""
        android:textColor="@color/custom_secondary"
        android:layout_marginTop="12dp"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/lb_number"
        app:layout_constraintTop_toBottomOf="@+id/tv_description" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="112dp"
        android:padding="18dp"
        android:text="@string/read_code"
        android:textSize="20sp"
        app:icon="@drawable/scanner_24"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_change_user"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:text="@string/change_login"
        android:textSize="20sp"
        app:icon="@drawable/account_24"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_open"
        tools:ignore="MissingConstraints"
        app:backgroundTint="?attr/colorSecondary"
        android:textColor="?attr/colorOnSecondary"
        app:iconTint="?attr/colorOnSecondary" />

</androidx.constraintlayout.widget.ConstraintLayout>