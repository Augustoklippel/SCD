<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".layout.ConfigActivity">

    <Space
        android:layout_width="match_parent"
        android:layout_height="60dp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/logo_etn"
        android:contentDescription="@string/logo_description"
        android:layout_gravity="center_vertical"
        />

    <Space
        android:layout_width="match_parent"
        android:layout_height="60dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_area"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:padding="18dp"
        app:icon="@drawable/map_24"
        app:iconPadding="10dp"
        android:textSize="20sp"
        app:iconGravity="textStart"
        app:iconSize="36dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_data"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:text="@string/btn_data"
        android:textSize="20sp"
        app:icon="@drawable/database_24"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="36dp"
        app:iconTint="?attr/colorOnSecondary" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sync"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:text="@string/btn_sync"
        android:textSize="20sp"
        app:icon="@drawable/database_24"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="36dp"
        app:iconTint="?attr/colorOnSecondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_update"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:text="@string/btn_update"
        android:textSize="20sp"
        app:icon="@drawable/update_24"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="36dp"
        app:backgroundTint="?attr/colorSecondary"
        android:textColor="?attr/colorOnSecondary"
        app:iconTint="?attr/colorOnSecondary" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="40dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/version"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textAlignment="center"/>
    <TextView
        android:id="@+id/tv_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="23sp"
        android:textColor="@color/custom_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textAlignment="center"/>

</LinearLayout>